<% display_global_config = ui_global_config(@global_config) %>
<footer class="pt-16 pb-8 flex flex-col items-center justify-center">
  <div class="mx-auto max-w-2xl text-center py-2">
    <div class="flex items-center gap-2">

        <img
          class="w-4 h-4"
          alt="<%= display_global_config['BRAND_NAME'] %>"
          src="<%= display_global_config['LOGO_THUMBNAIL'] %>"
        />
        <p class="text-slate-700 dark:text-slate-300 text-sm font-medium text-center">
          <%= I18n.t('public_portal.footer.made_with') %>

            <a class="hover:underline" href="<%= generate_portal_brand_url(display_global_config['BRAND_URL'], request.referer) %>" target="_blank" rel="noopener noreferrer nofollow"><%= display_global_config['INSTALLATION_NAME'] %></a>

        </p>
    </div>
  </div>
</footer>
