<div style="font-family: Arial, sans-serif; color: #111827; line-height: 1.7;">
  <p style="margin: 0 0 12px; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #0f766e;">
    Tư vấn sau mua khóa học
  </p>

  <h1 style="margin: 0 0 16px; font-size: 24px; line-height: 1.3; color: #111827;">
    <%= @step_title %>
  </h1>

  <div style="padding: 20px; border: 1px solid #e5e7eb; border-radius: 14px; background: #f8fafc;">
    <%= simple_format(h(@draft_body), {}, sanitize: false) %>
  </div>
</div>
