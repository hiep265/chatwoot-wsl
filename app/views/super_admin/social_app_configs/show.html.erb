<% content_for(:title) do %>
  Social App Config - <%= @account.name %>
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= content_for(:title) %>
  </h1>
</header>

<style>
.eye-icon.eye-hide path {
  d: path('M3 3l18 18M10.5 10.677a2 2 0 002.823 2.823M7.362 7.561C5.68 8.74 4.279 10.42 3 12c1.889 2.991 5.282 6 9 6 1.55 0 3.043-.523 4.395-1.35M12 6c4.008 0 6.701 3.009 9 6a15.66 15.66 0 01-1.078 1.5');
}
.provider-section { margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #e5e7eb; }
.provider-section:last-child { border-bottom: none; }
</style>

<section class="main-content__body">
  <% @providers.each do |provider| %>
    <% config = @configs[provider] %>
    <% fields = @provider_fields[provider] %>
    <div class="provider-section">
      <h3><%= provider.titleize %> Configuration</h3>

      <%= form_with url: super_admin_account_social_app_config_path(@account, provider: provider), method: :patch, local: true do |form| %>
        <% fields.each do |field| %>
          <div class="flex mb-8">
            <div class="field-unit__label">
              <%= form.label field, field.titleize %>
            </div>
            <div class="-mt-2 field-unit__field">
              <% if @secret_fields.include?(field) %>
                <div class="relative">
                  <%= form.password_field "social_app_config[#{field}]",
                      id: "social_app_config_#{provider}_#{field}",
                      value: config&.public_send(field),
                      class: "mt-2 border border-slate-100 p-1.5 pr-8 rounded-md w-full"
                  %>
                  <button
                    type="button"
                    class="absolute reset-base !bg-white top-1/2 !outline-0 !text-n-slate-11 -translate-y-1/2 right-2 p-1 hover:!bg-n-slate-5 rounded-sm toggle-password"
                    data-target="social_app_config_<%= provider %>_<%= field %>"
                  >
                    <svg class="eye-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 5C5.6363636 5 2 12 2 12C2 12 5.6363636 19 12 19C18.3636364 19 22 12 22 12C22 12 18.3636364 5 12 5Z"/>
                      <path d="M12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15Z"/>
                    </svg>
                  </button>
                </div>
              <% else %>
                <%= form.text_field "social_app_config[#{field}]",
                    value: config&.public_send(field),
                    class: "mt-2 border border-slate-100 p-1 rounded-md"
                %>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if %w[facebook instagram].include?(provider) %>
          <div class="flex mb-8">
            <div class="field-unit__label">
              <%= form.label :enable_human_agent, "Enable Human Agent" %>
            </div>
            <div class="-mt-2 field-unit__field">
              <%= form.select "social_app_config[enable_human_agent]",
                [["Use global", ""], ["True", "true"], ["False", "false"]],
                { selected: config&.settings&.key?('enable_human_agent') ? config.settings['enable_human_agent'].to_s : "" },
                class: "mt-2 border border-slate-100 p-1 rounded-md"
              %>
            </div>
          </div>
        <% end %>

        <div class="form-actions">
          <%= form.submit "Save #{provider.titleize} Config" %>
          <% if config %>
            <%= link_to "Delete #{provider.titleize} Config",
                super_admin_account_social_app_config_path(@account, provider: provider),
                method: :delete,
                data: { confirm: "Are you sure you want to delete this #{provider.titleize} config?" },
                class: "button button--danger" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>

<% content_for :javascript do %>
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.toggle-password').forEach(button => {
      button.addEventListener('click', () => {
        const targetId = button.dataset.target;
        const input = document.getElementById(targetId);
        const type = input.type === 'password' ? 'text' : 'password';
        input.type = type;

        const svg = button.querySelector('.eye-icon');
        if (type === 'password') {
          svg.classList.remove('eye-hide')
        } else {
          svg.classList.add('eye-hide')
        }
      });
    });
  });
  </script>
<% end %>
